<Window x:Class="MouseMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MouseMacro" Height="960" Width="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Background="{DynamicResource BackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBrush}" Padding="14,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="MouseMacro" Foreground="{DynamicResource TextBrush}"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="Macro" GroupName="Mode"
                                 IsChecked="{Binding IsMacroSelected, Mode=TwoWay}"
                                 FontWeight="SemiBold" Padding="6,2" Margin="0,0,16,0"/>
                    <RadioButton Content="Clicker" GroupName="Mode"
                                 IsChecked="{Binding IsClickerSelected, Mode=TwoWay}"
                                 FontWeight="SemiBold" Padding="6,2"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theme:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" Style="{DynamicResource BaseTextStyle}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              Width="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="14"/>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" Padding="14,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Style="{StaticResource BaseTextStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Start/Stop: Left Shift + Ctrl + S"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                    <TextBlock Text="      Record: Left Shift + Ctrl + R"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               Visibility="{Binding IsMacroSelected, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
